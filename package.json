    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.6.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.0",
