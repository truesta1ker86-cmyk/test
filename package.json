{
  "name": "ozon1c-v2",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "api:docs": "node development-api/serve.cjs",
    "build": "NG_BUILD_MAX_WORKERS=2 ng build --base-href /v2/ --delete-output-path=false && cp dist/ozon1c-v2/3rdpartylicenses.txt dist/ozon1c-v2/browser/3rdpartylicenses.txt",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format:check": "prettier --check src",
    "architecture:check": "node scripts/check-angular-architecture.mjs",
    "employer:check": "node scripts/check-employer-api.mjs",
    "filters:check": "node scripts/check-filter-integration.mjs"
  },
  "private": true,
  "scarfSettings": {
    "enabled": false
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@angular/router": "22.2.2",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "swagger-ui-dist": "5.33.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
